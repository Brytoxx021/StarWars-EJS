<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar <%= personaje.name %></title>
    <link rel="stylesheet" href="/app.css">
</head>
<body>
    <div class="container">
        <h1>Editar <%= personaje.name %></h1>

        <!-- Envía un PATCH mediante method-override -->
        <form action="/starwars/<%= (personaje.name) %>?_method=PATCH" method="POST">
            <div>
                <label for="height">Altura (cm):</label>
                <input type="number" id="height" name="height" value="<%= personaje.height %>" required>
            </div>

            <div>
                <label for="mass">Masa (kg):</label>
                <input type="number" id="mass" name="mass" value="<%= personaje.mass %>" required>
            </div>

            <button type="submit" class="btn btn-save">Guardar Cambios</button>
            <a href="/starwars/<%= (personaje.name) %>">Cancelar</a>
        </form>
    </div>
</body>
</html>