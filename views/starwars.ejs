<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Star Wars - Galería de Personajes</title>
    <link rel="stylesheet" href="/app.css">
</head>
<body>
    <h1>Galería de Personajes de Star Wars</h1>
    
    <div class="nav-links">
        <a href="/search.html">🔍 Ir al Buscador</a>
        <a href="/starwars/new">➕ Crear Nuevo Personaje</a>
    </div>

    <div class="grid-personajes">
        <% for(let p of personajes) { %>
            <div class="card-personaje">
                <a href="/starwars/<%= (p.name) %>">
                    <img src="<%= p.photo %>" alt="<%= p.name %>">
                    <h3><%= p.name %></h3>
                </a>
            </div>
        <% } %>
    </div>
</body>
</html>